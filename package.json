{
  "name": "@wzohny/agents-md-lint",
  "author": "Wael Zohny",
  "repository": {
    "type": "git",
    "url": "https://github.com/wzohny/agents-md-lint.git"
  },
  "bugs": {
    "url": "https://github.com/wzohny/agents-md-lint/issues"
  },
  "homepage": "https://github.com/wzohny/agents-md-lint#readme",
  "keywords": [
    "agents-md",
    "llms-txt",
    "linter",
    "ai-agents",
    "cli"
  ],
  "version": "0.1.1",
  "description": "Zero-dependency CLI linter for AGENTS.md and llms.txt files",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agents-md-lint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "lint:self": "node dist/cli.js .",
    "check": "npm run typecheck && npm run build && npm test && npm run lint:self",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
